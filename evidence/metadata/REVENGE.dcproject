	  <annotation addr="24C5:012E">V: RefreshTacticalOverview_012E restores terrain under the prior 24 unit markers and viewport frame, draws the current frame, then plots deployed friendly and opposing units from the persistent roster and live map coordinates.</annotation>
	  <annotation addr="24C5:02F1">V: DrawTacticalOverviewViewportFrame_02F1 snapshots the clamped tactical camera origin and draws its 19-by-12-cell extent as a doubled-pixel white rectangle on the overview.</annotation>
	  <annotation addr="24C5:037F">V: DrawTacticalOverviewMap_037F clears the video buffer, plots the complete aligned overview color map, invalidates all cached unit markers, and draws the tactical viewport frame.</annotation>
	  <annotation addr="24C5:0401">V: ExitTacticalOverview_0401 clears TacticalOverviewActive_8104, resets nine runtime sentinels at DS:B574, redraws the ordinary tactical interface, and restores the mouse cursor.</annotation>
